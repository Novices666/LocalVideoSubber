*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# 缓存
.pytest_cache/
.cache/
hf_cache/

# 前端依赖与构建产物
node_modules/

# TypeScript 编译缓存
*.tsbuildinfo
